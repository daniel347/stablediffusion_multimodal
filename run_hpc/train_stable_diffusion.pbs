#!/bin/bash
#PBS -l select=1:ncpus=4:mem=24gb:ngpus=1
#PBS -l walltime=01:00:00

eval "$(~/miniconda3/bin/conda shell.bash hook)"
conda activate mmvae
export PYTHONPATH="${PYTHONPATH}:${HOME}/python_modules/"

cd $HOME/multimodal_generation/stablediffusion/
python train_mm_stable_diffusion.py -cn celeba_semseg_diffusion_train +run=celeba_semseg_diffusion_z_comb_ablation_test_metrics
