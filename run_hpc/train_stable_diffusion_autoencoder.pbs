#!/bin/bash
#PBS -l select=1:ncpus=4:mem=24gb:ngpus=1
#PBS -l walltime=01:00:00

eval "$(~/miniconda3/bin/conda shell.bash hook)"
conda activate mmvae
export PYTHONPATH="${PYTHONPATH}:${HOME}/python_modules/"

cd $HOME/multimodal_generation/stablediffusion/
python train_mm_autoencoder_image_depth.py training.objective.params.wadversary=10000 model_initialisation=/rds/general/user/ds3119/ephemeral/outputs/MM_CelebA_Autoencoder/checkpoints/2025_06_16__13_20_58_patch_gan_train/model_200.pt training.num_epochs=1
