 from depth_anything_v2.dpt import DepthAnythingV2
+from depth_anything_v2.util.transform import Resize, NormalizeImage, PrepareForNet
 
 
+def image2tensor(raw_image, input_size=518):
+    transform = v2.Compose([
+        Resize(
+            width=input_size,
+            height=input_size,
+            resize_target=False,
+            keep_aspect_ratio=True,
+            ensure_multiple_of=14,
+            resize_method='lower_bound',
+            image_interpolation_method=cv2.INTER_CUBIC,
+        ),
+        CentreCropImage((input_size, input_size)),
+        NormalizeImage(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
+        PrepareForNet(),
+    ])
+    h, w = raw_image.shape[:2]
+    image = cv2.cvtColor(raw_image, cv2.COLOR_BGR2RGB) / 255.0
+    image = transform({'image': image})['image']
+    image = torch.from_numpy(image)
+
+    # print(f"dataset out shape: {image.shape}")
+
+    return image, (h, w)
+
+
+def rescale_imgs(outs, hws):
+    rescaled = []
+    if len(outs.shape) == 3:
+        outs = outs.unsqueeze(0)
+
+    for hw, out in zip(hws, outs):
+        print(out.shape)
+        print(hw)
+        out = torch.nn.functional.interpolate(
+            out.unsqueeze(0),
+            size=hw,
+            mode="bilinear",
+            align_corners=True,
+        )
+        rescaled.append(out.squeeze(0))
+    return rescaled
+
+
+class CentreCropImage(object):
+
+    def __init__(self, size):
+        self.crop = v2.CenterCrop(size)
+
+    def __call__(self, sample):
+        print(f"input shape: {sample['image'].shape}")
+        sample["image"] = self.crop(sample["image"])
+        print(f"output shape: {sample['image'].shape}")
+
+        return sample
+
+
+class HFDataset(IterableDataset):
+    def __init__(self, path, base_path, size=280):
+        self.ds = load_dataset(path, streaming=True)
+        self.base_path = Path(base_path)
+        self.size = size
+    
+    def generate(self):
+        for row in self.ds["train"]:
+            img = row["image"]
+            ind = row["image_id"]
+
+            img = np.asarray(img)
+            img = cv2.cvtColor(img, cv2.COLOR_RGB2BGR)
+            image, (h, w) = image2tensor(img, self.size)
+
+            yield {"image": image,
+                    "raw_img": img,
+                    "shape": (h, w),
+                    "filename": self.base_path / f"bedroom_{(ind // 10000) * 10000}/{ind}.jpg",}
+
+    def __iter__(self):
+        return iter(self.generate())
+
+
+class ImageDataset(Dataset):
+    def __init__(self, img_path, size=280):
+        if os.path.isfile(img_path):
+            if args.img_path.endswith('txt'):
+                with open(args.img_path, 'r') as f:
+                    self.filenames = f.read().splitlines()
+            else:
+                self.filenames = [args.img_path]
+        else:
+            self.filenames = glob.glob(os.path.join(args.img_path, '**/*.JPEG'), recursive=True)
+
+        self.size = size
+
+    def __len__(self):
+        return len(self.filenames)
+
+    def __getitem__(self, idx):
+        # print(self.filenames[idx])
+        raw_image = cv2.imread(self.filenames[idx])
+        image, (h, w) = image2tensor(raw_image, self.size)
+        return {"image": image,
+                "raw_img": raw_image,
+                "shape": (h, w),
+                "filename": self.filenames[idx]}
+
